skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Be Vietnam Pro"
skinparam defaultFontColor #1F2937
skinparam shadowing false
skinparam roundCorner 12
skinparam ArrowColor #2563EB
skinparam ArrowFontColor #6B7280
skinparam dpi 150
skinparam sequence {
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #2563EB
  LifeLineBorderColor #6B7280
  ActorBorderColor #2563EB
  ActorBackgroundColor #FFFFFF
}
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #F59E0B
}
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
}
skinparam package {
  BorderColor #6B7280
  FontColor #2563EB
}
skinparam note {
  BackgroundColor #F8FAFC
  BorderColor #6B7280
}
