@startuml
!include style.iuml
title Nhóm 2 và 3: Ghép cặp, kết nối
left to right direction
actor Student as S
actor Parent as P
actor Tutor as T
actor Admin as A
actor "AI Provider" as AI <<hệ thống ngoài>>
rectangle "Nhóm 2" {
  usecase "UC2.1\nTìm gia sư" as UC21
  usecase "UC2.2\nLọc danh sách" as UC22
  usecase "UC2.3\nGet Matched" as UC23
  usecase "UC2.4\nAI giải thích" as UC24
  usecase "UC2.5\nXem hồ sơ gia sư" as UC25
}
rectangle "Nhóm 3" {
  usecase "UC3.1-3.2\nMời và phản hồi liên kết" as UC31
  usecase "UC3.3\nThu hồi liên kết" as UC33
  usecase "UC3.4\nGửi yêu cầu kết nối" as UC34
  usecase "UC3.5\nPhản hồi yêu cầu" as UC35
}
S --> UC21
P --> UC21
S --> UC23
P --> UC23
S --> UC25
P --> UC25
S --> UC31
P --> UC31
S --> UC33
A --> UC33
S --> UC34
P --> UC34
T --> UC35
UC22 .up.> UC21 : <<extend>>
UC24 .up.> UC23 : <<extend>>
UC24 -- AI
@enduml
