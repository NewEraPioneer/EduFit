@startuml
!include style.iuml
title Use-case tổng quan hệ thống EduFit
left to right direction

actor Student as S
actor Parent as P
actor Tutor as T
actor Admin as A
actor "AI Provider" as AI <<hệ thống ngoài>>
actor "payOS" as OS <<hệ thống ngoài>>

rectangle "EduFit" {
  usecase "Quản lý tài khoản và hồ sơ" as UC1
  usecase "Xác minh gia sư" as UC2
  usecase "Tìm kiếm và ghép cặp gia sư" as UC3
  usecase "Liên kết và kết nối" as UC4
  usecase "Quản lý lịch học" as UC5
  usecase "Theo dõi lộ trình và tiến độ" as UC6
  usecase "Đánh giá và nhận thông báo" as UC7
  usecase "Nạp ví và thanh toán" as UC8
}

S --> UC1
P --> UC1
T --> UC1
A --> UC2
T --> UC2
S --> UC3
P --> UC3
S --> UC4
P --> UC4
T --> UC4
S --> UC5
P --> UC5
T --> UC5
S --> UC6
P --> UC6
T --> UC6
S --> UC7
P --> UC7
T --> UC7
S --> UC8
P --> UC8
T --> UC8
A --> UC8

UC1 -- AI
UC3 -- AI
UC8 -- OS
@enduml
