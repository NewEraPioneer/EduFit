# =============================================================================
# EduFit UAT Environment Variables Template (.env.uat.example)
# Dùng để cấu hình biến môi trường trên Render Web Service (UAT)
# hoặc nạp vào file cục bộ .env.uat.local (ĐÃ ĐƯỢC GIT IGNORE) để chạy thử nghiệm.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CẤU HÌNH SPRING BOOT (BẮT BUỘC)
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=uat
# Render tự động gán PORT (ví dụ 10000). Để trống hoặc 8080 khi chạy local.
SERVER_PORT=8080

# -----------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU SUPABASE UAT (BẮT BUỘC)
# Lấy từ Supabase Dashboard -> Project Settings -> Database -> Connection string
# Khuyến nghị: Chọn "Session pooler" (IPv4), cổng 5432. KHÔNG chọn cổng 6543 cho Flyway.
# -----------------------------------------------------------------------------
# Cách 1: Điền URL JDBC đầy đủ (Ưu tiên)
# Ví dụ: jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://<SUPABASE_POOLER_HOST>:5432/postgres?sslmode=require
# User có dạng postgres.<project-ref> khi dùng pooler
DB_USERNAME=postgres.<PROJECT_REF>
# Mật khẩu database Supabase đã đặt khi tạo project
DB_PASSWORD=<SUPABASE_DB_PASSWORD>

# Cách 2: Hoặc phân tách từng trường nếu không dùng DB_URL
DB_HOST=<SUPABASE_POOLER_HOST>
DB_PORT=5432
DB_NAME=postgres
HIKARI_MAX_POOL_SIZE=8
HIKARI_MIN_IDLE=2

# -----------------------------------------------------------------------------
# 3. FRONTEND & CORS / COOKIE (BẮT BUỘC)
# -----------------------------------------------------------------------------
# URL của Frontend Vercel (UAT), dùng để tạo link trong email và kiểm soát cookie
FRONTEND_BASE_URL=https://<YOUR_FRONTEND_UAT>.vercel.app
SESSION_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# 4. AI PLATFORM (TÙY CHỌN - MẶC ĐỊNH 'stub' NẾU CHƯA CÓ KEY)
# -----------------------------------------------------------------------------
# 'stub' (giả lập offline miễn phí) hoặc 'gemini' (gọi Google Gemini thật)
AI_PROVIDER=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------------
# 5. GOOGLE OAUTH2 (TÙY CHỌN)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# 6. CỔNG THANH TOÁN payOS (TÙY CHỌN - DÙNG MÔI TRƯỜNG TEST/SANDBOX)
# -----------------------------------------------------------------------------
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYMENT_BANK_ACCOUNT=
PAYMENT_FRONTEND_URL=https://<YOUR_FRONTEND_UAT>.vercel.app
PAYMENT_BANK_BIN=
PAYMENT_BANK_HOLDER=
PAYOS_PAYOUT_ENABLED=false

# -----------------------------------------------------------------------------
# 7. EMAIL DỊCH VỤ (TÙY CHỌN TRÊN UAT)
# Render Free chặn cổng SMTP 25, 465, 587. Để trống nếu chưa tích hợp HTTPS Email API.
# -----------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@edufit.vn
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
