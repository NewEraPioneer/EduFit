# Sao chép thành .env trước khi chạy docker compose (.env đã được Git bỏ qua).

# --- Chọn môi trường (đặt đầu file) ---
# Dấu , làm phân cách để chạy được trên cả Windows lẫn Linux/macOS.
COMPOSE_PATH_SEPARATOR=,
# Dev: db + backend + mail (frontend chạy tay bằng npm run dev, xem frontend/.env.example)
COMPOSE_FILE=compose.yaml,compose.dev.yaml
# Demo: thêm frontend để chạy cả hệ thống
# COMPOSE_FILE=compose.yaml,compose.dev.yaml,compose.demo.yaml

# --- Biến bắt buộc (compose báo lỗi nếu thiếu) ---
POSTGRES_DB=edufit
POSTGRES_USER=edufit
POSTGRES_PASSWORD=edufit-local-only
FRONTEND_PORT=3000
POSTGRES_PORT=5433
BACKEND_PORT=8080
MAILPIT_SMTP_PORT=1025
# Mã OTP xác thực đăng ký/quên mật khẩu ở dev/demo: mở http://localhost:8025 để đọc thư
MAILPIT_UI_PORT=8025

# =========================================================================
# Cấu hình AI Platform (Google Gemini / Stub)
# =========================================================================
# BẮT BUỘC chọn, không có giá trị mặc định: 'stub' (offline, dữ liệu giả lập) hoặc 'gemini' (gọi Google Gemini thật)
AI_PROVIDER=
# Khóa API Google Gemini (Lấy tại https://aistudio.google.com/)
GEMINI_API_KEY=
# Bắt buộc khi AI_PROVIDER=gemini (ví dụ: tên model lấy từ Google AI Studio); bỏ trống nếu dùng stub
GEMINI_MODEL=

# =========================================================================
# Cấu hình Xác thực Google OAuth2 (Đăng nhập Google)
# =========================================================================
# Google Client ID (Lấy từ Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# =========================================================================
# Cấu hình Cổng Thanh Toán payOS (Nạp tiền / Thanh toán)
# =========================================================================
# payOS kenh thu: dien truc tiep vao .env local, khong commit secret.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYMENT_BANK_ACCOUNT=
PAYMENT_FRONTEND_URL=http://localhost:3000
# QR thu cong tuy chon (Admin doi soat)
PAYMENT_BANK_BIN=
PAYMENT_BANK_HOLDER=
# Kenh chi rieng: chi bat sau khi duoc payOS cap quyen va co nguon tien chi.
PAYOS_PAYOUT_ENABLED=false
PAYOS_PAYOUT_CLIENT_ID=
PAYOS_PAYOUT_API_KEY=
PAYOS_PAYOUT_CHECKSUM_KEY=
