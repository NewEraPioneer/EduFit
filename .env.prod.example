# =============================================================================
# EduFit PRODUCTION Environment Variables Template (.env.prod.example)
# Dùng để cấu hình biến môi trường trên Render Web Service (PRODUCTION)
# CẢNH BÁO: CHỈ PHÁT HÀNH SAU KHI ĐƯỢC NGHIỆM THU KÝ DUYỆT (SIGN-OFF)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CẤU HÌNH SPRING BOOT (BẮT BUỘC)
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# -----------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU PRODUCTION (BẮT BUỘC - DATABASE ĐỘC LẬP VỚI UAT/DEV)
# Khuyến nghị: Sử dụng managed PostgreSQL có backup tự động hàng ngày
# -----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://<PROD_DB_HOST>:5432/<PROD_DB_NAME>?sslmode=require
DB_USERNAME=<PROD_DB_USER>
DB_PASSWORD=<PROD_DB_STRONG_PASSWORD>
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5

# -----------------------------------------------------------------------------
# 3. FRONTEND & DOMAIN CHÍNH THỨC (BẮT BUỘC)
# -----------------------------------------------------------------------------
FRONTEND_BASE_URL=https://edufit.vn
SESSION_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# 4. AI PLATFORM (BẮT BUỘC KHÓA GEMINI THẬT VÀ QUOTA PHÙ HỢP)
# -----------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=<PROD_GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.5-flash-lite

# -----------------------------------------------------------------------------
# 5. GOOGLE OAUTH2 (BẮT BUỘC KHI ĐĂNG NHẬP GOOGLE)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=<PROD_GOOGLE_CLIENT_ID>

# -----------------------------------------------------------------------------
# 6. CỔNG THANH TOÁN payOS (BẮT BUỘC - KÊNH THẬT ĐÃ ĐỐI SOÁT HỢP ĐỒNG)
# -----------------------------------------------------------------------------
PAYOS_CLIENT_ID=<PROD_PAYOS_CLIENT_ID>
PAYOS_API_KEY=<PROD_PAYOS_API_KEY>
PAYOS_CHECKSUM_KEY=<PROD_PAYOS_CHECKSUM_KEY>
PAYMENT_BANK_ACCOUNT=<PROD_BANK_ACCOUNT>
PAYMENT_FRONTEND_URL=https://edufit.vn
PAYMENT_BANK_BIN=<PROD_BANK_BIN>
PAYMENT_BANK_HOLDER=<PROD_BANK_HOLDER>
PAYOS_PAYOUT_ENABLED=false
PAYOS_PAYOUT_CLIENT_ID=
PAYOS_PAYOUT_API_KEY=
PAYOS_PAYOUT_CHECKSUM_KEY=

# -----------------------------------------------------------------------------
# 7. EMAIL DỊCH VỤ (BẮT BUỘC DỊCH VỤ EMAIL HTTPS/API HOẶC SMTP CHÍNH THỨC)
# -----------------------------------------------------------------------------
MAIL_HOST=<PROD_SMTP_HOST>
MAIL_PORT=587
MAIL_USERNAME=<PROD_SMTP_USER>
MAIL_PASSWORD=<PROD_SMTP_PASSWORD>
MAIL_FROM=support@edufit.vn
